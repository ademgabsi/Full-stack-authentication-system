# Leave empty for local development (uses Vite proxy to backend).
# Set to your backend URL for production (e.g. https://api.example.com).
VITE_API_BASE_URL=

# Cloudflare Turnstile Site Key
VITE_TURNSTILE_SITE_KEY=

# Google OAuth (used by backend only, listed here for reference)
# VITE_GOOGLE_CLIENT_ID=
